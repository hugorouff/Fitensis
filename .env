APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-this-secret-before-production
DATABASE_URL=sqlite:///%kernel.project_dir%/var/gym.db

# Assistant IA : moteur local par défaut.
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
# Alternative facultative, uniquement si AI_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_REQUESTS_PER_DAY=100
