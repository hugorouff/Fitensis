{% if chart.points %}
    <div class="perf-line" data-chart>
        <svg viewBox="0 0 580 220" role="group" aria-label="{{ chart_title }}">
            <line x1="48" y1="30" x2="548" y2="30" class="perf-gridline" />
            <line x1="48" y1="105" x2="548" y2="105" class="perf-gridline" />
            <line x1="48" y1="180" x2="548" y2="180" class="perf-gridline" />
            <text x="4" y="34">
                {{ chart.max|round(1) }}
            </text>
            <text x="18" y="184">
                0
            </text>
            {% for segment in chart.segments %}
                <polyline points="{{ segment }}" class="perf-line-path" />
            {% endfor %}
            {% for point in chart.points %}
                <circle
                    cx="{{ point.x }}"
                    cy="{{ point.y }}"
                    r="10"
                    class="perf-chart-target"
                    tabindex="0"
                    role="button"
                    aria-label="{{ point.label }} : {{ point.display }}"
                    data-chart-point="{{ point.label }} · {{ point.display }}"
                >
                    <title>
                        {{ point.label }} : {{ point.display }}
                    </title>
                </circle>
                <circle
                    cx="{{ point.x }}"
                    cy="{{ point.y }}"
                    r="3.5"
                    class="perf-chart-dot"
                />
            {% endfor %}
            <text x="48" y="210">
                {{ chart.first.date|date('d/m/y') }}
            </text>
            <text x="548" y="210" text-anchor="end">
                {{ chart.last.date|date('d/m/y') }}
            </text>
        </svg>
        <p class="perf-chart-caption" aria-live="polite">
            {{ chart.last.label }} · {{ chart.last.display }}
        </p>
        <small class="muted">
            Clique ou touche un point pour sa valeur. Au clavier : tabulation
            puis flèches.
        </small>
    </div>
{% else %}
    <p class="muted">
        Pas encore de données pour cet indicateur.
    </p>
{% endif %}
