<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <title>
            Créer mon compte · Fitensis
        </title>
        <link rel="icon" href="/assets/datensis-light.png" />
        <link rel="stylesheet" href="/assets/app.css?v=light1" />
        <meta name="theme-color" content="#00778B">
        <link rel="manifest" href="/manifest.json">
        <link rel="apple-touch-icon" href="/assets/fitensis-192.png">
        <script src="/assets/install.js" defer></script>
    </head>
    <body class="login">
        <div class="login-visual">
            <span class="auth-brand"><span class="datensis-mark" aria-hidden="true"></span> Fitensis</span><h1>Ton prochain<br />départ.</h1>
            <p>
                Crée ton compte et retrouve tes séances,<br />tes programmes et ta progression.
            </p>
            <div class="orb"></div>
        </div>
        <section class="login-form" style="padding-top:8vh">
            <span class="eyebrow">REJOINDRE LE CLUB</span><h2>Créer mon compte</h2>
            <p class="muted">
                L’inscription est immédiate, sans passer par un administrateur.
            </p>
            {% if error %}
                <div role="alert" class="flash error">
                    {{ error }}
                </div>
            {% endif %}
            <form method="post" action="/inscription">
                <input type="hidden" name="_token" value="{{ csrf_token('gym') }}" /><label>
                    Nom complet<input
                        name="name"
                        value="{{ name }}"
                        autocomplete="name"
                        minlength="2"
                        maxlength="150"
                        required
                    />
                </label><label>
                    Adresse mail<input
                        type="email"
                        name="email"
                        value="{{ email }}"
                        autocomplete="email"
                        maxlength="254"
                        required
                    />
                </label><label>
                    Mot de passe<input
                        type="password"
                        name="password"
                        autocomplete="new-password"
                        minlength="12"
                        maxlength="72"
                        required
                    /><small>12 caractères minimum.</small>
                </label><label>
                    Confirmer le mot de passe<input
                        type="password"
                        name="confirmation"
                        autocomplete="new-password"
                        minlength="12"
                        maxlength="72"
                        required
                    />
                </label><button>Créer mon compte →</button>
            </form>
            <p class="muted">
                Déjà inscrit ? <a href="/connexion">Me connecter</a>
            </p>
        </section>
    </body>
</html>
