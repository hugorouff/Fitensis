{% extends 'base.html.twig' %}
{% block body %}
    <div class="page-head">
        <div>
            <span class="eyebrow">TON ENTRAÎNEMENT EN UN COUP D’ŒIL</span><h1>
                Mes performances<span class="accent">.</span>
            </h1>
            <p class="muted">
                Tes habitudes et ton évolution, à partir des performances
                réellement enregistrées.
            </p>
        </div>
        <div class="actions">
            <a class="button" href="/calendrier">Préparer une séance →</a><a
                class="button"
                href="/performances/excel"
            >
                Importer un Excel
            </a><a
                class="button secondary"
                href="/performances/excel/export.xlsx?exercise={{ exercise|url_encode }}"
            >
                Exporter en Excel
            </a><a class="button secondary" href="/export/workouts.csv">
                Exporter en CSV
            </a>
        </div>
    </div>
    <section class="panel">
        <form method="get" class="form-grid">
            <label>
                Période<select name="period">
                    {% for value, label in {
                        all: 'Tout l’historique',
                        '30': '30 derniers jours',
                        '90': '90 derniers jours',
                        '365': '365 derniers jours'
                    } %}
                        <option
                            value="{{ value }}"
                            {{ period == value ? 'selected' : '' }}
                        >
                            {{ label }}
                        </option>
                    {% endfor %}
                </select>
            </label>
            <label>
                Exercice<select name="exercise">
                    {% for record in records %}
                        <option
                            {{ record.exercise == exercise ? 'selected' : '' }}
                        >
                            {{ record.exercise }}
                        </option>
                    {% else %}
                        <option value="">
                            Aucun exercice enregistré
                        </option>
                    {% endfor %}
                </select>
            </label>
            <label>
                Indicateur<select name="metric">
                    {% for value, spec in metrics %}
                        <option
                            value="{{ value }}"
                            {{ metric == value ? 'selected' : '' }}
                        >
                            {{ spec[0] }}
                        </option>
                    {% endfor %}
                </select>
            </label>
            <button>Afficher ma progression</button>
        </form>
        <p class="muted">
            Les filtres s’appliquent aux graphiques ci-dessous. L’export Excel
            contient tout ton historique personnel.
        </p>
    </section>
    <div class="perf-kpis">
        <article class="panel">
            <strong>{{ total_days }}</strong><span>jours d’entraînement</span>
        </article>
        <article class="panel">
            <strong>{{ total_exercises }}</strong><span>exercices différents</span>
        </article>
        <article class="panel">
            <strong>{{ total_sets }}</strong><span>séries enregistrées</span>
        </article>
        <article class="panel">
            <strong>
                {{ total_volume|number_format(0, ',', ' ') }} <small>kg</small>
            </strong><span>volume cumulé</span>
        </article>
    </div>
    {% if not records %}
        <section class="panel">
            <p class="empty">
                Aucune performance sur cette période. Note tes séries dans le
                carnet ou importe ton historique Excel pour voir tes graphiques.
            </p><a class="button" href="/espace/workouts">
                Ouvrir mon carnet →
            </a>
        </section>
    {% endif %}
    <div class="perf-dashboard">
        <section class="panel">
            <span class="eyebrow">TES HABITUDES</span><h2>
                Les exercices les plus pratiqués
            </h2>
            <p class="muted">
                Top 8 par nombre de jours distincts, même si tu notes plusieurs
                lignes le même jour. Clique sur un exercice pour voir sa
                progression.
            </p>
            {% for item in frequency %}
                <a
                    class="perf-rank"
                    href="?exercise={{ item.exercise|url_encode }}&period={{
                    period
                    }}&metric={{ metric }}"
                >
                    <span>{{ item.exercise }}</span><small>
                        {{ item.days }} j · {{ item.sets }} séries
                    </small><span class="perf-rank-track">
                        <span
                            style="width: {{
                            item.days / frequency[0].days
                                * 100
                            }}%"
                        >

                        </span>
                    </span>
                </a>
            {% else %}
                <p class="muted">
                    Tes exercices apparaîtront ici.
                </p>
            {% endfor %}
        </section>
        <section class="panel">
            <span class="eyebrow">TA RÉGULARITÉ</span><h2>
                Jours actifs par semaine
            </h2>
            <p class="muted">
                Jusqu’aux 12 dernières semaines de la période enregistrée.
                Chaque barre compte les jours d’entraînement, de 0 à 7.
            </p>
            {% if weekly %}
                <div
                    class="perf-weekly"
                    role="list"
                    aria-label="Jours d’entraînement par semaine"
                >
                    {% for week in weekly %}
                        <div
                            class="perf-week"
                            role="listitem"
                            title="Semaine du {{ week.date|date('d/m/Y') }} : {{
                            week.days
                            }} jours, {{ week.sets }} séries, {{
                            week.volume
                            }} kg de volume"
                        >
                            <strong>{{ week.days }} j</strong><div
                                class="perf-week-track"
                            >
                                <span
                                    style="height: {{ week.days / 7 * 100 }}%"
                                >

                                </span>
                            </div><small>{{ week.label }}</small>
                        </div>
                    {% endfor %}
                </div><small class="muted">
                    Date du lundi sous chaque barre. Dernière semaine affichée : {{
                        weekly|last.date|date('d/m/Y')
                    }}.
                </small>
            {% else %}
                <p class="muted">
                    Enregistre ta première séance pour commencer.
                </p>
            {% endif %}
        </section>
        <section class="panel perf-wide">
            <span class="eyebrow">TON ÉVOLUTION</span><h2>
                {{ exercise ? : 'Progression par exercice' }}
            </h2>
            <p class="muted">
                {{ metrics[metric][0] }} par date · {{ metrics[metric][1] }}.{% if
                    exercise_days > 365 %}Les 365 dernières dates enregistrées
                sont affichées.{% endif %}
            </p>
            {% if line.points %}
                <div class="perf-comparison">
                    <span>
                        Première date <strong>{{ line.first.display }}</strong>
                    </span><span>
                        Dernière date <strong>{{ line.last.display }}</strong>
                    </span><span>
                        Écart <strong>{{ line.change > 0 ? '+' : '' }}{{
                                line.change|number_format(1, ',', ' ')
                            }} {{ line.unit }}</strong>
                    </span>
                </div>
            {% endif %}
            {% include '_performance_line.html.twig' with {
                chart: line,
                chart_title: metrics[metric][0] ~ ' — ' ~ exercise
            } %}
            <p class="muted">
                Volume = séries × répétitions × charge. Répétitions = total
                réalisé, séries comprises. Le 1RM est une estimation Epley pour
                1 à 30 répétitions ; les valeurs absentes restent des
                interruptions de courbe. Compare charges, séries et répétitions
                ensemble.
            </p>
            {% if history %}
                <details>
                    <summary>
                        Voir les données du graphique
                    </summary>
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Charge max.</th>
                                    <th>Volume</th>
                                    <th>Séries</th>
                                    <th>Répétitions</th>
                                    <th>1RM estimé</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for h in history %}
                                    <tr>
                                        <td>{{ h.date|date('d/m/Y') }}</td>
                                        <td>{{ h.weight }} kg</td>
                                        <td>{{ h.volume }} kg</td>
                                        <td>{{ h.sets }}</td>
                                        <td>{{ h.reps }}</td>
                                        <td>
                                            {{ h.rm is not null
                                                ? (h.rm|round(1)) ~ ' kg'
                                                : '—' }}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </details>
            {% endif %}
        </section>
        {% if body %}
            <section class="panel perf-wide">
                <span class="eyebrow">TES MESURES</span><h2>
                    Évolution du poids corporel
                </h2>
                <p class="muted">
                    Dernière mesure de chaque date, jusqu’à 365 dates. À lire
                    selon ton objectif personnel.
                </p>
                {% include '_performance_line.html.twig' with {
                    chart: body_line,
                    chart_title: 'Évolution du poids corporel'
                } %}
                <details>
                    <summary>
                        Voir les mesures
                    </summary>
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Date</th>
                                    <th>Poids</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in body %}
                                    <tr>
                                        <td>{{ item.date|date('d/m/Y') }}</td>
                                        <td>{{ item.weight }} kg</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </details>
            </section>
        {% endif %}
    </div>
    <script defer src="/assets/performance-charts.js"></script>
{% endblock %}
