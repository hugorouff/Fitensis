{% extends '_auth_layout.html.twig' %}
{% block title %}Connexion · Fitensis{% endblock %}
{% block body %}
    <section class="auth-card" aria-labelledby="auth-title">
        <h1 id="auth-title">Connexion</h1>
        <p>Retrouve tes séances et suis ta progression.</p>

        {% for message in app.flashes('signed_out') %}
            <p class="auth-notice" role="status">{{ message }}</p>
        {% endfor %}
        {% if error %}
            <p class="auth-notice auth-error" role="alert">{{ error }}</p>
        {% endif %}

        <form method="post" action="{{ path('login') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('gym') }}" />
            <label>Adresse e-mail
                <input type="email" name="email" value="{{ email }}" autocomplete="username" required />
            </label>
            <label>Mot de passe
                <input type="password" name="password" autocomplete="current-password" required />
            </label>
            <button class="auth-submit" type="submit">Se connecter</button>
        </form>
        <p class="auth-register">Pas encore de compte ? <a href="{{ path('register') }}">Créer un compte</a></p>
    </section>
{% endblock %}
