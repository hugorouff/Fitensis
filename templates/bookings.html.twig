{% extends 'base.html.twig' %}{% block body %}<div class="page-head"><div><span class="eyebrow">VOTRE PLACE AU CLUB</span><h1>Réservations<span class="accent">.</span></h1></div><a class="button secondary" href="/export/bookings.csv">Exporter mes réservations</a></div>{% if gym.staff %}<section class="panel"><h2>Inscrire un adhérent</h2><form method="post" class="form-grid" id="staff-booking"><input type="hidden" name="_token" value="{{ csrf_token('gym') }}"><label>Adhérent<select name="user_id">{% for u in users %}<option value="{{ u.id }}">{{ u.name }}</option>{% endfor %}</select></label><label>Séance<select id="booking-session" required>{% for s in sessions %}<option value="{{ s.id }}">{{ s.title }} · {{ s.starts_at|date('d/m H:i') }}</option>{% endfor %}</select></label><button {{ sessions is empty?'disabled':'' }}>Inscrire</button></form></section>{% endif %}<div class="panel table-scroll"><input class="table-search" placeholder="Rechercher une réservation…" aria-label="Rechercher"><table><thead><tr><th>Cours</th><th>Adhérent</th><th>Date</th><th>État</th><th>Présence</th><th>Actions</th></tr></thead><tbody>{% for b in rows %}<tr><td><strong>{{ b.title }}</strong><small>{{ b.room }}</small></td><td>{{ b.name }}</td><td>{{ b.starts_at|date('d/m/Y H:i') }}</td><td><span class="pill {{ b.status }}">{{ {'confirmed':'Confirmée','waiting':'Liste d’attente','cancelled':'Annulée'}[b.status] }}</span></td><td>{{ b.attended?'Présent':'—' }}</td><td><div class="actions">{% if b.status!='cancelled' and b.starts_at|date('U')>'now'|date('U') %}<form method="post" action="/reservations/{{ b.id }}/annuler" data-confirm="Annuler cette réservation ?"><input type="hidden" name="_token" value="{{ csrf_token('gym') }}"><button class="small secondary">Annuler</button></form>{% endif %}{% if gym.staff and b.status=='confirmed' and b.starts_at|date('U')<='now'|date('U') %}<form method="post" action="/reservations/{{ b.id }}/presence"><input type="hidden" name="_token" value="{{ csrf_token('gym') }}"><button class="small">{{ b.attended?'Retirer présence':'Marquer présent' }}</button></form>{% endif %}</div></td></tr>{% else %}<tr><td colspan="6" class="empty">Aucune réservation. <a href="/calendrier">Choisir un cours →</a></td></tr>{% endfor %}</tbody></table></div>{% endblock %}
