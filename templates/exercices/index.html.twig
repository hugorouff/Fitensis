                                        data-muscle="shoulders"
                                        d="M69 27 C73 27 76 30 76 34 C76 38 73 40 69 39 C66 37 65 32 67 29 Z"
                                    />

                                    <!-- dorsaux -->
                                    <path
                                        data-muscle="back"
                                        d="M33 39 C39 40 44 43 50 45 C56 43 61 40 67 39 L65 65 C60 72 55 75 50 75 C45 75 40 72 35 65 Z"
