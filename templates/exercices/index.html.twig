        </main>

        <!-- Détails -->
        <div id="detailModal" class="modal">
            <div class="modal-card">
                <button class="close" type="button" data-close="detailModal">×</button>

                <h2 id="detailName"></h2>

                <div class="media-grid">
                    <div class="media">
                        <img id="detailImage" alt="" />
                        <div id="detailImageEmpty" class="media-empty" style="display: none">
                            Image indisponible
                        </div>
                    </div>

                    <div class="media">
                        <video
                            id="detailVideo"
                            controls
                            playsinline
                            preload="metadata"
                            style="display: none"
                        ></video>
                        <div id="detailVideoEmpty" class="media-empty">Vidéo indisponible</div>
                    </div>
                </div>

                <div id="detailText" class="details"></div>

                <button id="useExercise" type="button" class="action">
                    💪 Utiliser cet exercice
                </button>
                <button
                    id="deleteCustom"
                    type="button"
                    class="action delete-action"
                    style="display: none"
                >
                    🗑 Supprimer cet exercice personnalisé
                </button>
            </div>
        </div>

        <!-- Création -->
        <div id="createModal" class="modal">
            <div class="modal-card">
                <button class="close" type="button" data-close="createModal">×</button>

                <h2>Créer un exercice</h2>

                <form id="createForm">
                    <div class="form-grid">
                        <div class="field">
                            <label>Titre</label>
                            <input id="createName" required placeholder="Ex. Presse convergente" />
                        </div>

                        <div class="field">
                            <label>Muscle principal</label>
                            <select id="createPrimary" required></select>
                        </div>

                        <div class="field">
                            <label>Équipement</label>
                            <input id="createEquipment" placeholder="Machine, barre, haltères..." />
                        </div>

                        <div class="field">
                            <label>Difficulté</label>
                            <select id="createDifficulty">
                                <option value="beginner">Débutant</option>
                                <option value="intermediate" selected>Intermédiaire</option>
                                <option value="advanced">Avancé</option>
                            </select>
                        </div>
                    </div>

                    <div class="field">
                        <label>Muscles secondaires</label>
                        <div id="secondaryChoices" class="secondary-grid"></div>
                    </div>

                    <div class="field">
                        <label>Description</label>
                        <textarea
                            id="createDescription"
                            placeholder="Décris l'exercice, son exécution, les consignes..."
                        ></textarea>
                    </div>

                    <div class="field">
                        <label>URL de l'image</label>
                        <input id="createImage" type="url" placeholder="https://..." />
                    </div>

                    <div class="form-grid">
                        <div class="field">
                            <label>URL vidéo homme</label>
                            <input id="createMaleVideo" type="url" placeholder="https://...mp4" />
                        </div>

                        <div class="field">
                            <label>URL vidéo femme</label>
                            <input id="createFemaleVideo" type="url" placeholder="https://...mp4" />
                        </div>
                    </div>

                    <button class="action" type="submit">Enregistrer l'exercice</button>
                </form>
            </div>
        </div>

        <script>
            const BODY_IMAGES = {
                male: {
                    front: "https://raw.githubusercontent.com/Jsplice/MuscleMap/main/packages/assets/bodies/male-front.webp",
                    back: "https://raw.githubusercontent.com/Jsplice/MuscleMap/main/packages/assets/bodies/male-back.webp",
                },
                female: {
                    front: "https://raw.githubusercontent.com/Jsplice/MuscleMap/main/packages/assets/bodies/female-front.webp",
                    back: "https://raw.githubusercontent.com/Jsplice/MuscleMap/main/packages/assets/bodies/female-back.webp",
                },
            };

            const muscles = {
                chest: "Pectoraux",
                back: "Dos / Dorsaux",
                shoulders: "Épaules",
                biceps: "Biceps",
                triceps: "Triceps",
                forearms: "Avant-bras",
                traps: "Trapèzes",
                abs: "Abdominaux",
                obliques: "Obliques",
                lowerback: "Lombaires",
                quads: "Quadriceps",
                hamstrings: "Ischio-jambiers",
                glutes: "Fessiers",
                adductors: "Adducteurs",
                abductors: "Abducteurs",
                calves: "Mollets",
                serratus: "Dentelé antérieur",
                neck: "Cou",
            };

            const equipmentFr = {
                "body weight": "Poids du corps",
                barbell: "Barre",
                dumbbell: "Haltères",
                dumbbells: "Haltères",
                cable: "Poulie",
                band: "Élastique",
                "resistance band": "Élastique",
                "leverage machine": "Machine guidée",
                machine: "Machine",
                "smith machine": "Smith machine",
                kettlebell: "Kettlebell",
                "medicine ball": "Médecine-ball",
                "ez barbell": "Barre EZ",
                assisted: "Machine assistée",
                rope: "Corde",
                plate: "Disque",
                "stability ball": "Swiss ball",
                "bosu ball": "BOSU",
                "trap bar": "Trap bar",
                "sled machine": "Machine à traîneau",
            };

            const difficultyFr = {
                beginner: "Débutant",
                intermediate: "Intermédiaire",
                advanced: "Avancé",
            };

            // Les remplacements longs passent avant les mots simples.
            const exercisePhraseFr = [
                ["romanian deadlift", "soulevé de terre roumain"],
                ["stiff leg deadlift", "soulevé de terre jambes tendues"],
                ["straight leg deadlift", "soulevé de terre jambes tendues"],
                ["bench press", "développé couché"],
                ["incline press", "développé incliné"],
                ["decline press", "développé décliné"],
                ["chest press", "presse à pectoraux"],
                ["shoulder press", "développé épaules"],
                ["military press", "développé militaire"],
                ["overhead press", "développé au-dessus de la tête"],
                ["close grip", "prise serrée"],
                ["wide grip", "prise large"],
                ["neutral grip", "prise neutre"],
                ["reverse grip", "prise inversée"],
                ["single arm", "unilatéral"],
                ["single-arm", "unilatéral"],
                ["one arm", "unilatéral"],
                ["one-arm", "unilatéral"],
                ["bent over", "buste penché"],
                ["bent-over", "buste penché"],
                ["lat pulldown", "tirage vertical"],
                ["pull down", "tirage vertical"],
                ["pulldown", "tirage vertical"],
                ["pull-up", "traction pronation"],
                ["pull up", "traction pronation"],
                ["chin-up", "traction supination"],
                ["chin up", "traction supination"],
                ["seated row", "rowing assis"],
                ["upright row", "tirage menton"],
                ["t-bar row", "rowing T-bar"],
                ["rear delt fly", "oiseau pour deltoïdes postérieurs"],
                ["reverse fly", "oiseau inversé"],
                ["lateral raise", "élévation latérale"],
                ["front raise", "élévation frontale"],
                ["calf raise", "élévation mollets"],
                ["leg extension", "extension de jambes"],
                ["leg curl", "curl ischio-jambiers"],
                ["hamstring curl", "curl ischio-jambiers"],
                ["hip thrust", "hip thrust"],
                ["glute bridge", "pont fessier"],
                ["back extension", "extension lombaire"],
                ["triceps extension", "extension triceps"],
                ["tricep extension", "extension triceps"],
                ["triceps pushdown", "pushdown triceps"],
                ["tricep pushdown", "pushdown triceps"],
                ["preacher curl", "curl pupitre"],
                ["hammer curl", "curl marteau"],
                ["concentration curl", "curl concentration"],
                ["wrist curl", "flexion des poignets"],
                ["wrist extension", "extension des poignets"],
                ["face pull", "face pull"],
                ["pec deck", "pec deck"],
                ["chest fly", "écarté pectoraux"],
                ["cable fly", "écarté à la poulie"],
                ["reverse crunch", "crunch inversé"],
                ["hanging leg raise", "relevé de jambes suspendu"],
                ["leg raise", "relevé de jambes"],
                ["side plank", "gainage latéral"],
                ["plank", "gainage"],
                ["bulgarian split squat", "squat bulgare"],
                ["split squat", "squat fendu"],
                ["hack squat", "hack squat"],
                ["front squat", "squat avant"],
                ["back squat", "squat arrière"],
                ["goblet squat", "goblet squat"],
                ["sumo squat", "squat sumo"],
                ["hip abduction", "abduction de hanche"],
                ["hip abductor", "abducteurs de hanche"],
                ["abductor machine", "machine à abducteurs"],
                ["hip adduction", "adduction de hanche"],
                ["adductor machine", "machine à adducteurs"],
            ];

            const exerciseWordFr = {
                barbell: "barre",
                dumbbell: "haltère",
                dumbbells: "haltères",
                cable: "poulie",
                machine: "machine",
                seated: "assis",
                standing: "debout",
                lying: "allongé",
                incline: "incliné",
                decline: "décliné",
                reverse: "inversé",
                alternating: "alterné",
                alternate: "alterné",
                assisted: "assisté",
                weighted: "lesté",
                kneeling: "à genoux",
                squat: "squat",
                deadlift: "soulevé de terre",
                row: "rowing",
                curl: "curl",
                extension: "extension",
                press: "développé",
                fly: "écarté",
                raise: "élévation",
                lunge: "fente",
                crunch: "crunch",
                "push-up": "pompes",
                pushup: "pompes",
                dip: "dips",
                dips: "dips",
            };

            function equipmentLabel(value) {
                const raw = String(value || "").trim();
                return equipmentFr[raw.toLowerCase()] || raw || "Équipement non renseigné";
            }

            function difficultyLabel(value) {
                const raw = String(value || "").trim();
                return difficultyFr[raw.toLowerCase()] || raw || "Non renseignée";
            }

            function frenchExerciseName(name) {
                if (!name) return "Exercice";

                let result = String(name).toLowerCase();

                for (const [english, french] of exercisePhraseFr) {
                    result = result.split(english).join(french);
                }

                result = result
                    .split(/\s+/)
                    .map((word) => exerciseWordFr[word] || word)
                    .join(" ")
                    .replace(/\s+/g, " ")
                    .trim();

                return result.charAt(0).toUpperCase() + result.slice(1);
            }

            function frenchDescription(exercise) {
                if (exercise.shortDescription) {
                    return exercise.shortDescription;
                }

                const principal = muscles[exercise.primaryGroup] || "le groupe musculaire ciblé";
                const secondaries = (exercise.secondaryGroups || [])
                    .map((group) => muscles[group] || group)
                    .filter(Boolean);

                let text = `Exercice de musculation ciblant principalement ${principal}`;

                if (secondaries.length) {
                    text += `, avec une participation secondaire de ${secondaries.join(", ")}`;
                }

                text += `. Équipement : ${equipmentLabel(exercise.equipment)}.`;
                return text;
            }

            let gender = "male";
            let currentMuscle = null;
            let selectedExercise = null;
            let searchTimer = null;

            const categoryBox = document.getElementById("categories");
            const grid = document.getElementById("exerciseGrid");
            const status = document.getElementById("status");

            function esc(value) {
                return String(value ?? "")
                    .replaceAll("&", "&amp;")
                    .replaceAll("<", "&lt;")
                    .replaceAll(">", "&gt;")
                    .replaceAll('"', "&quot;")
                    .replaceAll("'", "&#039;");
            }

            function showStatus(message) {
                status.className = "status error";
                status.textContent = message;
            }

            function clearStatus() {
                status.className = "status";
                status.textContent = "";
            }

            function setGender(value) {
                gender = value;
                document.getElementById("maleButton").classList.toggle("active", value === "male");
                document
                    .getElementById("femaleButton")
                    .classList.toggle("active", value === "female");

                document.getElementById("frontImage").src = BODY_IMAGES[value].front;
                document.getElementById("backImage").src = BODY_IMAGES[value].back;
            }

            function setMuscle(value) {
                currentMuscle = value;
                if (visualMode && value) selectSessionMuscle(value);

                document.getElementById("selectedMuscle").textContent = value
                    ? muscles[value]
                    : "Tous les exercices";

                document.querySelectorAll(".cat").forEach((button) => {
                    button.classList.toggle("active", button.dataset.muscle === value);
                });

                document.querySelectorAll(".muscle-svg path").forEach((path) => {
                    path.classList.toggle("active", path.dataset.muscle === value);
                });
            }

            Object.entries(muscles).forEach(([key, label]) => {
                const button = document.createElement("button");
                button.className = "cat";
                button.type = "button";
                button.dataset.muscle = key;
                button.textContent = label;

                button.addEventListener("click", () => {
                    setMuscle(key);
                    loadExercises();
                });

                categoryBox.appendChild(button);
            });

            document.querySelectorAll(".muscle-svg path").forEach((path) => {
                path.addEventListener("click", () => {
                    setMuscle(path.dataset.muscle);
                    loadExercises();
                });
            });

            const visualForm = document.getElementById("visual-session-form");
            const visualItems = document.getElementById("visual-session-items");
            const visualStatus = document.getElementById("visual-session-status");
            const visualMode = new URLSearchParams(location.search).get("seance") === "1";
            let visualIndex = 0;
            const shortcut = document.getElementById("visual-session-shortcut");
            function updateSessionShortcut() {
                const count = visualItems.children.length;
                shortcut.textContent = `Ma séance · ${count} exercice${count > 1 ? "s" : ""}`;
            }

            if (visualMode) {
                shortcut.hidden = false;
                document.getElementById("visual-session-create").hidden = true;
                document.getElementById("visual-session").hidden = false;
                const today = new Date();
                today.setMinutes(today.getMinutes() - today.getTimezoneOffset());
                visualForm.elements.date.value = today.toISOString().slice(0, 10);
                for (const [key, name] of Object.entries(muscles)) {
                    const label = document.createElement("label");
                    const input = document.createElement("input");
                    input.type = "checkbox";
                    input.name = "muscles[]";
                    input.value = key;
                    label.append(input, document.createTextNode(name));
                    document.getElementById("visual-session-muscles").append(label);
                }
                visualForm.addEventListener("submit", event => {
                    if (!visualItems.children.length || !visualForm.querySelector('[name="muscles[]"]:checked')) {
                        event.preventDefault();
                        visualStatus.textContent = "Choisis au moins un muscle et ajoute un exercice.";
                    }
                });
            }

            function selectSessionMuscle(key) {
                for (const input of visualForm.querySelectorAll('[name="muscles[]"]')) {
                    if (input.value === key) input.checked = true;
                }
            }

            function addToVisualSession(exercise) {
                if (visualItems.children.length >= 20) {
                    visualStatus.textContent = "La séance contient déjà 20 exercices.";
                    return;
                }
                const row = document.createElement("div");
                row.className = "visual-session-fields visual-session-item";
                const name = exercise.name_fr || frenchExerciseName(exercise.name);
                const heading = document.createElement("strong");
                heading.textContent = name;
                const field = document.createElement("input");
                field.type = "hidden";
                field.name = `items[${visualIndex}][name]`;
                field.value = name;
                const preview = document.createElement("div");
                preview.className = "visual-session-preview";
                const thumb = document.createElement("div");
                thumb.className = "visual-session-preview-image";
                const img = document.createElement("img");
                img.alt = name;
                img.loading = "lazy";
                const empty = document.createElement("span");
                empty.textContent = "Image indisponible";
                thumb.append(img, empty);
                loadExerciseImage(img, exercise, empty);
                const identity = document.createElement("div");
                identity.append(heading, exerciseMediaButton(exercise));
                preview.append(thumb, identity);
                row.append(preview, field);
                for (const [key, labelText, value, min, max] of [
                    ["sets", "Séries", 3, 1, 50],
                    ["reps", "Répétitions", 10, 1, 200],
                    ["weight", "Charge (kg)", 0, 0, 1000],
                ]) {
                    const label = document.createElement("label");
                    label.textContent = labelText;
                    const input = document.createElement("input");
                    Object.assign(input, {
                        name: `items[${visualIndex}][${key}]`, type: "number",
                        value, min, max, step: key === "weight" ? "any" : "1", required: true,
                    });
                    label.append(input);
                    row.append(label);
                }
                const remove = document.createElement("button");
                remove.type = "button";
                remove.className = "btn btn-secondary";
                remove.textContent = "Retirer";
                remove.addEventListener("click", () => {
                    row.remove();
                    updateSessionShortcut();
                    visualStatus.textContent = `${name} retiré.`;
                });
                row.append(remove);
                visualItems.append(row);
                updateSessionShortcut();
                visualIndex++;
                selectSessionMuscle(currentMuscle || exercise.primaryGroup);
                visualStatus.textContent = `${name} ajouté à la séance.`;
            }

            function loadExerciseImage(element, exercise, fallback) {
                const thumbnails = exercise.thumbnails || {};
                const images = [...new Set([
                    imageFor(exercise), thumbnails.male, thumbnails.female, exercise.fallbackImageUrl,
                ].filter(Boolean))];
                function next() {
                    if (!images.length) {
                        element.removeAttribute("src");
                        element.style.display = "none";
                        fallback.style.display = "flex";
                        return;
                    }
                    element.src = images.shift();
                }
                element.onerror = next;
                fallback.style.display = "none";
                element.style.display = "";
                next();
            }

            function imageFor(exercise) {
                const thumbs = exercise.thumbnails || {};

                return gender === "female"
                    ? thumbs.female || thumbs.male || ""
                    : thumbs.male || thumbs.female || "";
            }

            function videoFor(exercise) {
                const videos = exercise.videos || {};

                return gender === "female"
                    ? videos.female || videos.male || ""
                    : videos.male || videos.female || "";
            }

            function exerciseMediaButton(exercise) {
                const button = document.createElement("button");
                const hasVideo = Boolean(videoFor(exercise));
                button.type = "button";
                button.className = "exercise-media-button";
                button.textContent = hasVideo ? "Voir la vidéo" : "Voir la fiche";
                button.addEventListener("click", event => {
                    event.stopPropagation();
                    openDetails(exercise);
                    if (hasVideo) {
                        document.getElementById("detailVideoEmpty").parentElement.scrollIntoView({ block: "nearest" });
                    }
                });
                return button;
            }

            async function loadExercises() {
                clearStatus();
                grid.innerHTML = `<div class="thumb-fallback">Chargement...</div>`;

                const params = new URLSearchParams({
                    limit: "400",
                    include_secondary: document.getElementById("includeSecondary").checked
                        ? "true"
                        : "false",
                });

                if (currentMuscle) {
                    params.set("muscle", currentMuscle);
                }

                const search = document.getElementById("search").value.trim();
                if (search) {
                    params.set("search", search);
                }

                try {
                    const response = await fetch(`/api/exercises?${params}`);

                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }

                    const payload = await response.json();
                    document.getElementById("count").textContent =
                        `${payload.total} exercice${payload.total > 1 ? "s" : ""}`;

                    render(payload.data || []);
                    const meta = payload.source_status;
                    if (meta) {
                        status.style.display = "block";
                        status.textContent =
                            "Source : " +
                            meta.source +
                            (meta.storage === "postgresql"
                                ? " · fiches enregistrées en base"
                                : meta.stale
                                  ? " · dernière version enregistrée (source indisponible)"
                                : meta.status === "degraded"
                                  ? " · mode de secours local"
                                  : meta.cached
                                    ? " · données en cache"
                                    : " · données récupérées sur Internet");
                    }
                } catch (error) {
                    grid.innerHTML = "";
                    document.getElementById("count").textContent = "0 exercice";
                    showStatus(`Impossible de charger les exercices : ${error.message}`);
                }
            }

            function render(items) {
                grid.innerHTML = "";

                if (!items.length) {
                    grid.innerHTML = `<div class="thumb-fallback">Aucun exercice trouvé.</div>`;
                    return;
                }

                for (const exercise of items) {
                    const card = document.createElement("article");
                    card.className = "exercise";

                    const primary =
                        muscles[exercise.primaryGroup] || exercise.target || "Non classé";

                    card.innerHTML = `
                <div class="thumb">
                    <img alt="${esc(exercise.name)}" loading="lazy">
                    <div class="thumb-fallback">Image indisponible</div>
                </div>

                <div class="content">
                    <div class="name">${esc(exercise.name_fr || frenchExerciseName(exercise.name))}</div>

                    <div class="info">
                        ${esc(equipmentLabel(exercise.equipment))}
                        <br>
                        Principal : ${esc(primary)}
                    </div>

                    <div class="badges">
                        ${exercise.difficulty ? `<span class="badge">${esc(difficultyLabel(exercise.difficulty))}</span>` : ""}
                        ${exercise.source === "custom" ? `<span class="badge custom-badge">Personnalisé</span>` : ""}
                    </div>
                </div>
            `;

                    loadExerciseImage(card.querySelector("img"), exercise, card.querySelector(".thumb-fallback"));
                    card.querySelector(".content").append(exerciseMediaButton(exercise));
                    if (visualMode) {
                        const add = document.createElement("button");
                        add.type = "button";
                        add.className = "btn btn-secondary visual-session-add";
                        add.textContent = "+ Ajouter à ma séance";
                        add.addEventListener("click", event => {
                            event.stopPropagation();
                            addToVisualSession(exercise);
                        });
                        card.querySelector(".content").append(add);
                    }
                    card.addEventListener("click", () => openDetails(exercise));
                    grid.appendChild(card);
                }
            }

            function listHtml(title, values) {
                if (!Array.isArray(values) || !values.length) return "";

                return `
            <h3>${esc(title)}</h3>
            <ul>
                ${values.map((value) => `<li>${esc(value)}</li>`).join("")}
            </ul>
        `;
            }

            let detailRequest = 0;
            function openDetails(exercise, loaded = false) {
                const requestId = ++detailRequest;
                selectedExercise = exercise;

                document.getElementById("detailName").textContent =
                    exercise.name_fr || frenchExerciseName(exercise.name);

                if (!loaded) {
                    loadExerciseImage(
                        document.getElementById("detailImage"), exercise,
                        document.getElementById("detailImageEmpty"),
                    );

                    const video = document.getElementById("detailVideo");
                    const videoEmpty = document.getElementById("detailVideoEmpty");
                    const videos = exercise.videos || {};
                    const candidates = [...new Set([videoFor(exercise), videos.male, videos.female].filter(Boolean))];

                    video.pause();
                    function nextVideo() {
                        video.onerror = null;
                        if (candidates.length) {
                            video.onerror = nextVideo;
                            video.src = candidates.shift();
                            video.style.display = "block";
                            videoEmpty.style.display = "none";
                            return;
                        }
                        video.removeAttribute("src");
                        video.style.display = "none";
                        videoEmpty.textContent = videoFor(exercise)
                            ? "Vidéo indisponible chez le fournisseur."
                            : "Aucune vidéo fournie pour cet exercice.";
                        videoEmpty.style.display = "flex";
                    }
                    nextVideo();
                }

                const primary = muscles[exercise.primaryGroup] || exercise.target || "Non classé";

                const secondary = (exercise.secondaryGroups || [])
                    .map((group) => muscles[group] || group)
                    .join(", ");

                document.getElementById("detailText").innerHTML = `
            <p><strong>Muscle principal :</strong> ${esc(primary)}</p>
            <p><strong>Muscles secondaires :</strong> ${esc(secondary || "Aucun")}</p>
            <p><strong>Équipement :</strong> ${esc(equipmentLabel(exercise.equipment))}</p>
            <p><strong>Difficulté :</strong> ${esc(difficultyLabel(exercise.difficulty))}</p>
            <p><strong>Description :</strong> ${esc(frenchDescription(exercise))}</p>
            ${true ? listHtml("Étapes", exercise.steps) : ""}
            ${true ? listHtml("Conseils", exercise.formCues) : ""}
            ${true ? listHtml("Erreurs fréquentes", exercise.commonMistakes) : ""}
            ${
                exercise.breathing
                    ? `<p><strong>Respiration :</strong> ${esc(exercise.breathing)}</p>`
                    : ""
            }
        `;

                document.getElementById("deleteCustom").style.display =
                    exercise.source === "custom" ? "block" : "none";

                document.getElementById("detailModal").style.display = "flex";
                const detailBox = document.getElementById("detailText");
                const links = document.createElement("div");
                links.style.cssText = "display:flex;gap:12px;flex-wrap:wrap;margin:18px 0";
                for (const [title, url] of [
                    [
                        "Préparer une séance",
                        "/calendrier?muscle=" +
                            encodeURIComponent(exercise.primaryGroup || "") +
                            "&exercise=" +
                            encodeURIComponent(
                                exercise.name_fr || frenchExerciseName(exercise.name),
                            ),
                    ],
                    [
                        "Noter ma séance",
                        "/espace/workouts?exercise=" +
                            encodeURIComponent(
                                exercise.name_fr || frenchExerciseName(exercise.name),
                            ),
                    ],
                ]) {
                    const a = document.createElement("a");
                    a.textContent = title + " ↗";
                    a.href = url;
                    a.target = "_blank";
                    a.rel = "noopener noreferrer";
                    a.style.color = "#bfffaf";
                    links.appendChild(a);
                }
                if (visualMode) {
                    const add = document.createElement("button");
                    add.type = "button";
                    add.className = "btn btn-primary";
                    add.textContent = "Ajouter à ma séance";
                    add.addEventListener("click", () => {
                        addToVisualSession(exercise);
                        closeModal("detailModal");
                    });
                    links.prepend(add);
                }
                detailBox.appendChild(links);
                if (exercise.description_original) {
                    const original = document.createElement("details");
                    const summary = document.createElement("summary");
                    summary.textContent = "Texte original";
                    const paragraph = document.createElement("p");
                    paragraph.textContent = [
                        exercise.name,
                        exercise.description_original,
                        ...(exercise.steps_original || []),
                        ...(exercise.formCues_original || []),
                        ...(exercise.commonMistakes_original || []),
                        exercise.breathing_original || "",
                    ].join("\n");
                    paragraph.style.whiteSpace = "pre-line";
                    original.append(summary, paragraph);
                    detailBox.appendChild(original);
                }
                const note = document.createElement("p");
                note.style.cssText = "font-size:12px;color:var(--fitensis-muted)";
                note.textContent =
                    exercise.source === "remote"
                        ? loaded
                            ? "Source : " +
                              (exercise.source_name || "Internet") +
                              " · Traduction automatique, texte source conservé si indisponible."
                            : "Chargement des consignes détaillées et de leur traduction…"
                        : "Fiche personnelle ou catalogue local";
                detailBox.appendChild(note);
                if (exercise.source === "remote" && !loaded) {
                    fetch("/api/exercises/" + encodeURIComponent(exercise.id) + "/details")
                        .then((r) => {
                            if (!r.ok) throw new Error();
                            return r.json();
                        })
                        .then((payload) => {
                            if (
                                requestId === detailRequest &&
                                document.getElementById("detailModal").style.display === "flex"
                            )
                                openDetails(payload.data, true);
                        })
                        .catch(() => {
                            if (requestId === detailRequest)
                                note.textContent =
                                    "Traduction indisponible : les consignes de la source restent affichées.";
                        });
                }
            }

            function closeModal(id) {
                if (id === "detailModal") detailRequest++;
                const modal = document.getElementById(id);

                if (id === "detailModal") {
                    document.getElementById("detailVideo").pause();
                }

                modal.style.display = "none";
            }

            document.querySelectorAll("[data-close]").forEach((button) => {
                button.addEventListener("click", () => closeModal(button.dataset.close));
            });

            document.querySelectorAll(".modal").forEach((modal) => {
                modal.addEventListener("click", (event) => {
                    if (event.target === modal) {
                        closeModal(modal.id);
                    }
                });
            });

            document.getElementById("useExercise").addEventListener("click", () => {
                if (!selectedExercise) return;

                window.location.href = `/?exercise=${encodeURIComponent(selectedExercise.name_fr || frenchExerciseName(selectedExercise.name))}`;
            });

            document.getElementById("deleteCustom").addEventListener("click", async () => {
                if (!selectedExercise?.customId) return;

                if (!confirm("Supprimer cet exercice personnalisé ?")) return;

                const response = await fetch(`/api/custom-exercises/${selectedExercise.customId}`, {
                    method: "DELETE",
                });

                if (!response.ok) {
                    alert("Impossible de supprimer l'exercice.");
                    return;
                }

                closeModal("detailModal");
                await loadExercises();
            });

            document.getElementById("maleButton").addEventListener("click", () => {
                setGender("male");
                loadExercises();
            });

            document.getElementById("femaleButton").addEventListener("click", () => {
                setGender("female");
                loadExercises();
            });

            document.getElementById("includeSecondary").addEventListener("change", loadExercises);

            document.getElementById("search").addEventListener("input", () => {
                clearTimeout(searchTimer);
                searchTimer = setTimeout(loadExercises, 250);
            });

            // Création d'exercice
            const primary = document.getElementById("createPrimary");
            const secondaryChoices = document.getElementById("secondaryChoices");

            Object.entries(muscles).forEach(([key, label]) => {
                const option = document.createElement("option");
                option.value = key;
                option.textContent = label;
                primary.appendChild(option);

                const row = document.createElement("label");
                row.className = "secondary-check";
                row.innerHTML = `
            <input type="checkbox" value="${key}">
            ${esc(label)}
        `;
                secondaryChoices.appendChild(row);
            });

            document.getElementById("createButton").addEventListener("click", () => {
                document.getElementById("createModal").style.display = "flex";
            });

            document.getElementById("createForm").addEventListener("submit", async (event) => {
                event.preventDefault();

                const secondaryMuscles = Array.from(
                    secondaryChoices.querySelectorAll("input:checked"),
                ).map((input) => input.value);

                const payload = {
                    name: document.getElementById("createName").value.trim(),
                    primary_muscle: document.getElementById("createPrimary").value,
                    secondary_muscles: secondaryMuscles,
                    equipment:
                        document.getElementById("createEquipment").value.trim() || "Non renseigné",
                    difficulty: document.getElementById("createDifficulty").value,
                    description: document.getElementById("createDescription").value.trim(),
                    image_url: document.getElementById("createImage").value.trim(),
                    male_video_url: document.getElementById("createMaleVideo").value.trim(),
                    female_video_url: document.getElementById("createFemaleVideo").value.trim(),
                };

                const response = await fetch("/api/custom-exercises", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload),
                });

                const data = await response.json();

                if (!response.ok) {
                    alert(data.detail || "Erreur lors de la création.");
                    return;
                }

                event.target.reset();
                closeModal("createModal");

                setMuscle(payload.primary_muscle);
                await loadExercises();

                alert("Exercice créé et sauvegardé.");
            });

            document.addEventListener("keydown", (event) => {
                if (event.key === "Escape") {
                    closeModal("detailModal");
                    closeModal("createModal");
                }
            });

            setGender("male");
            loadExercises();
            const requestedExercise = new URLSearchParams(location.search).get("exercise");
            if (requestedExercise)
                fetch("/api/exercises/" + encodeURIComponent(requestedExercise) + "/details")
                    .then((response) => {
                        if (!response.ok) throw new Error();
                        return response.json();
                    })
                    .then((payload) => openDetails(payload.data || payload))
                    .catch(() => {
                        document.getElementById("search").value = requestedExercise;
                        loadExercises();
                    });
        </script>
    </body>
</html>
