                </section>

                <section class="card">
                    <div class="help">
                        👆 Clique sur la forme d'un muscle du corps ou choisis le groupe ci-dessous.
                    </div>

                    <div id="categories" class="categories"></div>

                    <label class="secondary-option">
                        <input id="includeSecondary" type="checkbox" checked />
                        Inclure les exercices où le muscle est travaillé en secondaire
                    </label>

                    <input
                        id="search"
                        class="search"
                        type="search"
                        placeholder="🔎 Rechercher un exercice..."
                    />

                    <div class="list-head">
                        <h2 id="selectedMuscle">Tous les exercices</h2>
