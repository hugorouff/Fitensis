<!doctype html>
<html lang="fr">
    <head>
        <script>
            {
                const uid = "{{ user_id }}";
                const get = Storage.prototype.getItem,
                    set = Storage.prototype.setItem,
                    remove = Storage.prototype.removeItem;
                const key = (k) => (String(k).startsWith("gymapp") ? "user-" + uid + "-" + k : k);
                Storage.prototype.getItem = function (k) {
                    return get.call(this, key(k));
                };
                Storage.prototype.setItem = function (k, v) {
                    return set.call(this, key(k), v);
                };
                Storage.prototype.removeItem = function (k) {
                    return remove.call(this, key(k));
                };
            }
        </script>
        <meta name="csrf-token" content="{{ csrf_token('gym') }}" />
        <script>
            const originalFetch = window.fetch;
            window.fetch = (url, options = {}) => {
                if (
                    typeof url === "string" &&
                    url.startsWith("/api/") &&
                    options.method &&
                    !["GET", "HEAD"].includes(options.method.toUpperCase())
                ) {
                    options.headers = {
                        ...options.headers,
                        "X-CSRF-TOKEN": document.querySelector('meta[name="csrf-token"]').content,
                    };
                }
                return originalFetch(url, options);
            };
        </script>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Fitensis - Exercices</title>

        <style>
            :root {
                --bg: var(--fitensis-bg);
                --card: var(--fitensis-card);
                --dark: var(--fitensis-bg-soft);
                --border: var(--fitensis-bg-soft);
                --blue: #2563eb;
                --muted: #94a3b8;
                --red: #ef4444;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                font-family: Arial, Helvetica, sans-serif;
                background: var(--bg);
                color: var(--fitensis-ink);
            }

            header {
                padding: 18px 24px;
                background: var(--fitensis-card);
                border-bottom: 1px solid var(--border);
            }

            .header-inner {
                max-width: 1500px;
                margin: auto;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 15px;
                flex-wrap: wrap;
            }

            .header-inner h1 {
                margin: 0;
            }

            .header-actions {
                display: flex;
                gap: 10px;
                flex-wrap: wrap;
            }

            .header-actions a,
            .header-actions button {
                border: 0;
                text-decoration: none;
                color: var(--fitensis-ink);
                background: var(--blue);
                border-radius: 9px;
                padding: 11px 16px;
                cursor: pointer;
                font-weight: 700;
                font-size: 14px;
            }

            .container {
                max-width: 1500px;
                margin: auto;
                padding: 25px 20px 50px;
            }

            .title {
                text-align: center;
                margin-bottom: 25px;
            }

            .title h2 {
                margin: 0 0 8px;
                font-size: 32px;
            }

            .title p {
                margin: 0;
                color: var(--fitensis-muted);
            }

            .layout {
                display: grid;
                grid-template-columns: minmax(560px, 0.95fr) minmax(560px, 1.35fr);
                gap: 25px;
                align-items: start;
            }

            .card {
                background: var(--card);
                border-radius: 18px;
                padding: 22px;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
            }

            .body-head {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 12px;
                flex-wrap: wrap;
                margin-bottom: 12px;
            }

            .body-head h2 {
                margin: 0;
            }

            .gender {
                display: flex;
                gap: 8px;
            }

            .gender button {
                border: 0;
                border-radius: 9px;
                background: var(--fitensis-bg-soft);
                color: var(--fitensis-ink);
                padding: 10px 15px;
                cursor: pointer;
                font-weight: 700;
            }

            .gender button.active {
                background: var(--blue);
            }

            .body-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 18px;
            }

            .body-view {
                text-align: center;
            }

            .body-view h3 {
                margin: 8px 0 10px;
            }

            .body-stage {
                position: relative;
                width: 100%;
                max-width: 320px;
                aspect-ratio: 2 / 3;
                margin: auto;
                border-radius: 16px;
                overflow: hidden;
                background: #eef2f7;
            }

            .body-stage img {
                width: 100%;
                height: 100%;
                display: block;
                object-fit: cover;
            }

            .muscle-svg {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                pointer-events: none;
            }

            .muscle-svg path {
                pointer-events: auto;
                fill: rgba(239, 68, 68, 0.02);
                stroke: rgba(255, 255, 255, 0);
                stroke-width: 0.8;
                cursor: pointer;
                transition:
                    fill 0.16s ease,
                    stroke 0.16s ease,
                    filter 0.16s ease;
            }

            .muscle-svg path:hover {
                fill: rgba(239, 68, 68, 0.3);
                stroke: rgba(255, 255, 255, 0.95);
                filter: drop-shadow(0 0 4px rgba(239, 68, 68, 0.9));
            }

            .muscle-svg path.active {
                fill: rgba(239, 68, 68, 0.42);
                stroke: #fff;
                filter: drop-shadow(0 0 5px rgba(239, 68, 68, 1));
            }

            .help {
                background: #e3f2f5;
                border-left: 4px solid #3b82f6;
                padding: 14px;
                border-radius: 9px;
                margin-bottom: 16px;
            }

            .categories {
                display: flex;
                flex-wrap: wrap;
                gap: 8px;
                margin-bottom: 16px;
            }

            .cat {
                border: 0;
                border-radius: 999px;
                padding: 9px 13px;
                background: var(--fitensis-bg-soft);
                color: var(--fitensis-ink);
                cursor: pointer;
            }

            .cat.active,
            .cat:hover {
                background: var(--blue);
            }

            .secondary-option {
                display: flex;
                gap: 9px;
                align-items: center;
                margin: 12px 0 16px;
                color: var(--fitensis-muted);
            }

            .secondary-option input {
                width: auto;
            }

            .search {
                width: 100%;
                background: var(--bg);
                color: var(--fitensis-ink);
                border: 1px solid #475569;
                border-radius: 10px;
                padding: 13px;
                font-size: 16px;
                margin-bottom: 15px;
            }

            .list-head {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 12px;
                border-bottom: 1px solid var(--border);
                padding-bottom: 12px;
                margin-bottom: 15px;
            }

            .list-head h2 {
                margin: 0;
            }

            .count {
                border-radius: 999px;
                padding: 6px 11px;
                background: var(--blue);
                font-size: 13px;
            }

            .status {
                display: none;
                padding: 12px;
                border-radius: 10px;
                margin-bottom: 15px;
            }

            .status.error {
                display: block;
                background: #ffebe5;
            }

            .exercise-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(235px, 1fr));
                gap: 14px;
            }

            .exercise {
                background: var(--dark);
                border: 1px solid var(--border);
                border-radius: 14px;
                overflow: hidden;
                cursor: pointer;
                transition:
                    transform 0.15s ease,
                    border-color 0.15s ease;
            }

            .exercise:hover {
                transform: translateY(-2px);
                border-color: #3b82f6;
            }

            .thumb {
                position: relative;
                height: 150px;
                background: var(--fitensis-card);
            }

            .thumb img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                display: block;
            }

            .thumb-fallback {
                width: 100%;
                height: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--muted);
                text-align: center;
                padding: 12px;
            }

            .play {
                position: absolute;
                right: 10px;
                bottom: 10px;
                width: 34px;
                height: 34px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                background: var(--fitensis-mint);
            }

            .content {
                padding: 13px;
            }

            .name {
                font-weight: 800;
                margin-bottom: 7px;
            }

            .info {
                color: var(--fitensis-muted);
                font-size: 13px;
                line-height: 1.4;
            }

            .badges {
                display: flex;
                gap: 6px;
                flex-wrap: wrap;
                margin-top: 9px;
            }

            .badge {
                border-radius: 999px;
                padding: 4px 7px;
                font-size: 11px;
                background: #deeff4;
            }

            .custom-badge {
                background: #d8f0e3;
            }

            .modal {
                display: none;
                position: fixed;
                z-index: 1000;
                inset: 0;
                background: rgba(0, 0, 0, 0.82);
                align-items: center;
                justify-content: center;
                padding: 20px;
            }

            .modal-card {
                position: relative;
                width: min(1050px, 96vw);
                max-height: 92vh;
                overflow: auto;
                background: var(--card);
                border-radius: 18px;
                padding: 22px;
            }

            .close {
                position: absolute;
                top: 10px;
                right: 15px;
                border: 0;
                background: transparent;
                color: var(--fitensis-ink);
                font-size: 30px;
                cursor: pointer;
            }

            .media-grid {
                display: grid;
                grid-template-columns: 1fr 1.2fr;
                gap: 15px;
            }

            .media {
                border-radius: 12px;
                overflow: hidden;
                background: var(--fitensis-card);
                min-height: 230px;
            }

            .media img,
            .media video {
                width: 100%;
                height: 100%;
                min-height: 230px;
                max-height: 420px;
                object-fit: contain;
                display: block;
            }

            .media-empty {
                min-height: 230px;
                display: flex;
                justify-content: center;
                align-items: center;
                color: var(--muted);
            }

            .details {
                line-height: 1.5;
                margin-top: 16px;
            }

            .action {
                width: 100%;
                border: 0;
                border-radius: 9px;
                padding: 13px;
                background: var(--blue);
                color: var(--fitensis-ink);
                cursor: pointer;
                font-weight: 800;
                margin-top: 14px;
            }

            .delete-action {
                background: #f9d4cc;
            }

            .form-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }

            .field {
                margin-bottom: 12px;
            }

            .field label {
                display: block;
                margin-bottom: 6px;
                color: var(--fitensis-muted);
            }

            .field input,
            .field select,
            .field textarea {
                width: 100%;
                background: var(--bg);
                color: var(--fitensis-ink);
                border: 1px solid #475569;
                border-radius: 9px;
                padding: 11px;
                font: inherit;
            }

            .field textarea {
                min-height: 100px;
                resize: vertical;
            }

            .secondary-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 8px;
            }

            .secondary-check {
                display: flex;
                gap: 7px;
                align-items: center;
                background: var(--fitensis-bg);
                border-radius: 8px;
                padding: 8px;
                font-size: 13px;
            }

            .secondary-check input {
                width: auto;
            }

            @media (max-width: 1180px) {
                .layout {
                    grid-template-columns: 1fr;
                }
            }

            @media (max-width: 720px) {
                .body-grid,
                .media-grid,
                .form-grid {
                    grid-template-columns: 1fr;
                }

                .secondary-grid {
                    grid-template-columns: 1fr 1fr;
                }
            }
        </style>
