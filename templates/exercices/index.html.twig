                            </div>
                        </div>

                        <div class="body-view">
                            <h3>ARRIÈRE</h3>

                            <div class="body-stage">
                                <img id="backImage" alt="Corps humain de dos" />

                                <svg
                                    class="muscle-svg"
                                    viewBox="0 0 100 150"
                                    preserveAspectRatio="none"
                                >
                                    <!-- trapèzes -->
                                    <path
                                        data-muscle="traps"
                                        d="M38 24 C44 21 56 21 62 24 L68 37 C60 42 40 42 32 37 Z"
                                    />

                                    <!-- épaules arrière : recalées sur les deltoïdes postérieurs -->
                                    <path
                                        data-muscle="shoulders"
                                        d="M31 27 C27 27 24 30 24 34 C24 38 27 40 31 39 C34 37 35 32 33 29 Z"
                                    />
