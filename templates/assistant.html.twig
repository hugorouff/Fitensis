{% extends 'base.html.twig' %}

{% block title %}Assistant · Fitensis{% endblock %}

{% block body %}
    <div class="page-head">
        <div>
            <h1>Assistant Fitensis</h1>
            <p class="muted">Prépare une séance selon tes objectifs ou trouve une recette avec les ingrédients que tu as.</p>
        </div>
        <div class="actions">
            <a class="button secondary" href="#planifier">Séance</a>
            <a class="button secondary" href="#suggestions-recettes">Recettes</a>
            <a class="button secondary" href="#bilan">Progression</a>
        </div>
    </div>

    {% include '_session_planner.html.twig' %}

    <section class="panel" id="suggestions-recettes">
        <h2>Idées de recettes</h2>
        <form method="get" action="/assistant#suggestions-recettes">
            <label>Ingrédients disponibles
                <input name="ingredients" value="{{ ingredients }}" maxlength="300" placeholder="Ex. poulet, riz, tomates" />
            </label>
            <label>Ingrédients à écarter (facultatif)
                <input name="exclude" value="{{ exclude }}" maxlength="300" placeholder="Ex. poisson, champignons" />
            </label>
            <button type="submit">Suggérer des recettes</button>
        </form>

        {% if recipeError %}
            <p role="alert">{{ recipeError }}</p>
        {% elseif recipes is not null %}
            {% if recipes.message %}<p class="muted">{{ recipes.message }}</p>{% endif %}
            <div class="session-results">
                {% for recipe in recipes.data %}
                    <div class="session-result-row">
                        <span>
                            <strong>{{ recipe.name_fr }}</strong>
                            {% if ingredients and not recipe.metadata_unknown and recipe.recipe_ingredient_total %}
                                <br /><small>{{ recipe.owned_recipe_ingredients }}/{{ recipe.recipe_ingredient_total }} ingrédients disponibles</small>
                            {% endif %}
                        </span>
                        <a href="/recipes?recipe={{ recipe.id|url_encode }}">Voir la recette</a>
                    </div>
                {% else %}
                    <p>Aucune recette trouvée avec ces critères.</p>
                {% endfor %}
            </div>
        {% endif %}
    </section>

    <section class="panel" id="bilan">
        <h2>Reprendre ta progression</h2>
        {% if lastWorkout %}
            <p>Dernière performance : <strong>{{ lastWorkout.exercise }}</strong>,
                {{ lastWorkout.sets }} × {{ lastWorkout.reps }} à {{ lastWorkout.weight }} kg,
                le {{ lastWorkout.date|date('d/m/Y') }}.</p>
            <p>Pour comparer tes prochaines séances, note les séries et répétitions réellement effectuées.</p>
        {% else %}
            <p>Enregistre une performance après ta première séance pour afficher ton dernier repère ici.</p>
        {% endif %}
        <a href="/performances">Ouvrir mes performances</a>
    </section>

    <script defer src="/assets/portions.js"></script>
    <section id="ai-results" aria-live="polite">
        {% if selected and selected.status == 'completed' %}
            {% include '_assistant_result.html.twig' with {
                run: selected
            } %}
        {% elseif selected %}
            <p class="panel muted">
                Cette demande {{ selected.status == 'pending'
                    ? 'est encore en cours ou a été interrompue'
                    : 'n’a pas abouti' }}. 
            </p>
        {% endif %}
    </section>

    <section class="panel" id="ai-favorites">
        <h2>Mes recettes favorites de l’assistant</h2>
        <div class="cards">
            {% for favorite in favorites %}
                {% set recipe = favorite.recipe %}
                <details class="ai-favorite ai-fold">
                    <summary>
                        <strong>{{ recipe.title }}</strong><span class="muted">Recette favorite ·
                            ouvrir</span>
                    </summary>
                    <div class="ai-fold-body">
                        {% include '_recipe_card.html.twig' with {
                            recipe: recipe
                        } %}
                        <form method="post" action="/assistant/favoris/{{ favorite.id }}/retirer">
                            <input type="hidden" name="_token" value="{{ csrf_token('gym') }}" />
                            <button class="link">Retirer des favoris</button>
                        </form>
                    </div>
                </details>
            {% else %}
                <p class="muted">
                    Tes recettes enregistrées apparaîtront ici.
                </p>
            {% endfor %}
        </div>
    </section>

    <section class="panel">
        <div class="section-head">
            <h2>Historique de l’ancien assistant</h2>
            {% if history %}
                <form
                    method="post"
                    action="/assistant/historique/effacer"
                    data-confirm="Effacer l’historique IA ? Les séances et recettes déjà enregistrées seront conservées."
                >
                    <input type="hidden" name="_token" value="{{ csrf_token('gym') }}" />
                    <button class="link danger">Effacer l’historique</button>
                </form>
            {% endif %}
        </div>
        {% for item in history %}
            <a class="ai-history-row" href="/assistant?run={{ item.id }}#ai-results">
                <span>{{ item.question }}</span>
                <small>
                    {{ item.created_at|date('d/m H:i') }} · {{
                        {
                            pending: 'En cours',
                            completed: 'Répondu',
                            failed: 'À réessayer'
                        }[item.status]
                    }}
                </small>
            </a>
        {% else %}
            <p class="muted">
                Aucune ancienne demande.
            </p>
        {% endfor %}
    </section>
{% endblock %}
