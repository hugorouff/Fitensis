    <script defer src="/assets/session-builder.js?v=1"></script>
    <section class="panel" id="planifier">
        <h2>{{ edit ? 'Modifier ma séance' : 'Préparer une séance' }}</h2>
        <form method="post" action="/entrainements/enregistrer" class="form-grid">
            <input type="hidden" name="_token" value="{{ csrf_token('gym') }}" />
            <input type="hidden" name="id" value="{{ edit.id|default('') }}" /><label>
                Type de séance<select name="preset" id="training-preset">
                    {% for key, preset in presets %}
                        <option
                            value="{{ key }}"
                            data-muscles="{{ preset.muscles|json_encode }}"
                            data-title="{{ preset.label }}"
                            {{ (edit.preset|default(initialPreset)) == key ? 'selected' : '' }}
                        >
                            {{ preset.label }}
                        </option>
                    {% endfor %}
                </select>
            </label><label>
                Nom (facultatif)<input
                    name="title"
                    id="training-title"
                    value="{{ edit.title|default('') }}"
                    placeholder="Ex. Haut du corps · force"
                    maxlength="250"
                />
            </label><label>
                Date<input
                    name="date"
                    type="date"
                    value="{{ edit ? edit.starts_at|date('Y-m-d') : selectedDate }}"
                    required
                />
            </label><label>
                Heure repère<input
                    name="time"
                    type="time"
                    value="{{ edit ? edit.starts_at|date('H:i') : '18:00' }}"
                    required
                />
            </label><label>
                Durée prévue (minutes)<input
                    name="duration"
                    type="number"
                    min="10"
                    max="300"
                    value="{{ edit.duration_minutes|default(60) }}"
                    required
                />
            </label>{% if not edit %}
                <label>
                    Répéter chaque semaine<input
                        name="repeat"
                        type="number"
                        min="1"
                        max="12"
                        value="1"
                    /><small>1 à 12 occurrences.</small>
                </label>
            {% endif %}
            <fieldset class="wide muscle-selector">
                <legend>
                    Parties du corps à entraîner
                </legend>
                {% for key, label in muscles %}
                    <label class="checkbox">
                        <input
                            type="checkbox"
                            name="muscles[]"
                            value="{{ key }}"
                            {{ key in (edit ? edit.muscle_ids : initialGroups) ? 'checked' : '' }}
                        /> {{ label }}
                    </label>
                {% endfor %}
            </fieldset>
            {% if not edit %}
                <fieldset class="wide session-builder" data-session-builder data-recent-exercises="{{ recentExercises|json_encode|e('html_attr') }}">
                    <legend>Exercices de la séance</legend>
                    <div class="form-grid">
                        <label>Rechercher dans le catalogue
                            <input type="search" data-exercise-search placeholder="Ex. développé couché" autocomplete="off" />
                        </label>
                        <label>Objectif
                            <select data-training-goal>
                                <option value="general">Remise en forme</option>
                                <option value="strength">Force</option>
                                <option value="volume">Prise de muscle</option>
                            </select>
                        </label>
                        <label>Matériel disponible
                            <select data-training-equipment>
                                <option value="all">Tout le matériel</option>
                                <option value="bodyweight">Poids du corps</option>
                                <option value="dumbbell">Haltères et poids du corps</option>
                            </select>
                        </label>
                    </div>
                    <div class="actions">
                        <button type="button" data-training-suggest>Suggérer des exercices</button>
                    </div>
                    <p class="muted" role="status" data-builder-status></p>
                    <div data-exercise-results class="session-results"></div>
                    <div data-exercise-plan class="session-results"></div>
                    <input type="hidden" name="exercise" value="{{ exercise }}" data-seeded-exercise />
                    <noscript>Active JavaScript pour rechercher et ajouter plusieurs exercices.</noscript>
                </fieldset>
            {% endif %}
            <label class="wide">
                Notes / objectif de la séance<textarea
                    name="notes"
                    rows="2"
                    placeholder="Ex. améliorer la technique, viser 3 × 10 à 60 kg"
                >
                    {{ edit.notes|default('') }}
                </textarea>
            </label><div class="actions">
                <button>{{ edit ? 'Enregistrer' : 'Créer ma séance →' }}</button><a href="/performances">Voir
                    mes performances</a>
            </div>
        </form>
    </section>
